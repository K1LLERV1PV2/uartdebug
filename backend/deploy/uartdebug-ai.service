[Unit]
Description=UartDebug AVR AI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uartai
Group=uartai
WorkingDirectory=/var/www/uartdebug/backend
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8083
Environment=ALLOWED_ORIGINS=https://uartdebug.com
Environment=AI_ENABLED=1
Environment=AI_REQUIRE_ACCESS_TOKEN=0
Environment=AI_RULE_PACK_ROOT=/var/lib/uartdebug-ai/rule-packs
Environment=AI_DRAFTS_DIR=/var/lib/uartdebug-ai/drafts
Environment=AI_BUDGET_FILE=/var/lib/uartdebug-ai/drafts/daily-budget.json
Environment=AI_DRAFT_TTL_HOURS=720
Environment=AI_MAX_DRAFTS=100
Environment=AI_RATE_WINDOW_MS=1800000
Environment=AI_RATE_REQUESTS=3
Environment=AI_DAILY_LIMIT=10
Environment=AI_MAX_CONCURRENT=1
Environment=OPENAI_MODEL=gpt-5.6-terra
Environment=OPENAI_REASONING_EFFORT=medium
Environment=OPENAI_TIMEOUT_MS=120000
Environment=OPENAI_MAX_OUTPUT_TOKENS=24000
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LoadCredential=openai_api_key:/etc/uartdebug/secrets/openai-api-key
LoadCredential=ai_access_token:/etc/uartdebug/secrets/ai-access-token
ExecStart=/usr/bin/node /var/www/uartdebug/backend/ai-server.js
Restart=on-failure
RestartSec=3
TimeoutStartSec=20
TimeoutStopSec=15

NoNewPrivileges=true
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/uartdebug-ai/drafts
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectProc=invisible
ProcSubset=pid
TasksMax=64
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
